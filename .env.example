# API keys for external data sources.
# Copy this file to .env and fill in your keys.

# OpenCorporates – company registry (free tier: 500 req/month)
OPENCORPORATES_TOKEN=

# North Data – company intelligence (paid API)
NORTH_DATA_API_KEY=

# NewsAPI.org – news search (free tier: 100 req/day)
NEWSAPI_KEY=

# GNews – news search (free tier: 100 req/day)
GNEWS_KEY=

# Logging level (DEBUG, INFO, WARNING)
LOG_LEVEL=INFO
